{
  "name": "femxo-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @femxo/web --filter @femxo/web-customer dev",
    "dev:web": "pnpm --filter @femxo/web dev",
    "dev:shop": "pnpm --filter @femxo/web-customer dev",
    "build:web": "pnpm --filter @femxo/web build",
    "build:shop": "pnpm --filter @femxo/web-customer build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "test:e2e:demo": "pnpm -r test:e2e:demo"
  }
}

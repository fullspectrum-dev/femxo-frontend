# Where femxo-backend runs (server-side only). The site forwards /auth,
# /access and /territories there, so the API's refresh cookie works
# same-origin with no CORS setup.
FEMXO_API_ORIGIN=http://localhost:3000

# Optional: call the API origin directly from the browser instead of through
# the forwarding above. It must be on the same site as this frontend (e.g.
# https://api.femxo.com for https://femxo.com) because the refresh cookie is
# SameSite=Strict, and its CORS_ORIGINS must list this site.
# NEXT_PUBLIC_API_BASE_URL=https://api.femxo.com

# Where the customer storefront (apps/web-customer) runs. The landing page's
# "Customer sign in" links to <this>/login. Read at build time; no trailing slash.
# NEXT_PUBLIC_STORE_URL=http://localhost:3002

# The site runs on dummy data (demo sign-in in the browser) by default, locally
# and in production, so no backend is needed yet. To connect femxo-backend,
# set this to false at build time and set FEMXO_API_ORIGIN above.
# NEXT_PUBLIC_AUTH_DEMO_MODE=false
#
# The admin lists (users, roles, products, transfers) switch to the live API with
# NEXT_PUBLIC_ADMIN_DATA_MODE=live. Modules without a backend then show "coming soon".
# NEXT_PUBLIC_ADMIN_DATA_MODE=live

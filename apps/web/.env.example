# Where femxo-backend runs (server-side only). The site forwards the API's route
# groups (see next.config.ts) there, so the refresh cookie (Path=/auth,
# SameSite=Strict) works same-origin with no CORS setup.
FEMXO_API_ORIGIN=http://localhost:3000

# Optional: call the API origin directly from the browser instead. It must be on
# the same site as this frontend because the refresh cookie is SameSite=Strict,
# and its CORS_ORIGINS must list this site.
# NEXT_PUBLIC_API_BASE_URL=https://api.femxo.com

# Where the customer storefront (apps/web-customer) runs. Read at build time.
# NEXT_PUBLIC_STORE_URL=http://localhost:3002

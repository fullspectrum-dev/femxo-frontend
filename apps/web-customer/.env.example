# Origin of femxo-backend (no trailing slash). REQUIRED in production: the build/start fails without it.
# The browser calls /store/v1/* on this site and Next forwards it here; server components call it directly.
FEMXO_API_ORIGIN=http://localhost:3000

# Where product images are served from (the backend's S3_PUBLIC_BASE_URL origin). Allows next/image to load them.
FEMXO_IMAGE_ORIGIN=

# Public site URL (canonical links, sitemap, JSON-LD). No secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Search engines: leave unset/false everywhere except production.
NEXT_PUBLIC_ALLOW_INDEXING=false

# The OTP length and resend wait come from the backend (GET /store/v1/auth/config): nothing to set here.
# Payments: Razorpay Checkout is loaded from https://checkout.razorpay.com only when a customer pays. The key id comes from the
# backend with each payment; no payment key or secret lives in this app.

# Set to "true" to enforce the Content-Security-Policy instead of only reporting violations.
CSP_ENFORCE=false
